# ============================================================
# LearnFlow — environment template.
#   cp .env.example .env   →  lalu ganti nilai dummy.
# .env DILARANG di-commit (sudah di .gitignore).
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=LearnFlow API
APP_VERSION=0.1.0
# development | production (production mematikan /docs)
APP_ENV=development
LOG_LEVEL=info
# Pisahkan dengan koma. Tanpa trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=LearnFl0w
POSTGRES_DB=learnflow
# Dipakai saat backend jalan DI HOST (uvicorn/pytest langsung).
# Di dalam Docker Compose nilai ini DI-OVERRIDE menjadi postgres-db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Port host (compose bind ke 127.0.0.1 saja) ───────────────
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000

# ── LLM (dipakai mulai Milestone 1 / Node 1-3) ───────────────
# gemini | claude | openai | deepseek
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=dummy_key_replace_me
LLM_TEMPERATURE=0.2

# ── Rate limit (slowapi) ─────────────────────────────────────
RATE_LIMIT_GENERATE=3/hour
RATE_LIMIT_DEFAULT=60/minute
